{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "jsx": "react-jsx",
        "paths": {
            "@assets/*": ["./src/assets/*"],
            "@components": ["./src/components"],
            "@components/*": ["./src/components/*"],
            "@editor": ["./src/editor"],
            "@editor/*": ["./src/editor/*"],
            "@entities": ["./src/entities"],
            "@entities/*": ["./src/entities/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@services/*": ["./src/services/*"],
            "@stores/*": ["./src/stores/*"],
            "@utils": ["./src/utils"],
            "@utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src"]
}
