{
    "name": "ardoise",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "description": "Local-first markdown notes, in your browser.",
    "author": "Jules Paris",
    "license": "MIT",
    "homepage": "https://ardoise.page",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/theJpay/ardoise.git"
    },
    "bugs": {
        "url": "https://github.com/theJpay/ardoise/issues"
    },
    "keywords": [
        "markdown",
        "notes",
        "local-first",
        "react",
        "typescript"
    ],
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "postinstall": "npm run build -w @ardoise/shared",
        "shared:build": "npm run build -w @ardoise/shared",
        "shared:dev": "npm run dev -w @ardoise/shared",
        "client:dev": "npm run dev -w @ardoise/client",
        "client:build": "npm run build -w @ardoise/client",
        "client:preview": "npm run preview -w @ardoise/client",
        "client:test": "npm test -w @ardoise/client",
        "api:dev": "npm run dev -w @ardoise/api",
        "api:build": "npm run build -w @ardoise/api",
        "api:start": "npm run start -w @ardoise/api",
        "supabase:start": "supabase start",
        "supabase:stop": "supabase stop",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "release:pr": "gh pr create --base main --head beta --title \"Release v$npm_package_version\" --body \"$(git log --since=\"$(git log -1 --format=%aI $(git describe --tags --abbrev=0 main))\" beta --first-parent --no-merges --pretty=format:'- %s')\"",
        "release:sync-beta": "git checkout beta && git fetch origin && git merge origin/main --no-edit && git push",
        "release:tag": "gh release create \"v$npm_package_version\" --target main --generate-notes --title \"v$npm_package_version\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "supabase": "^2.110.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.65.0"
    }
}
